{
 "uid": "thesis-live",
 "title": "Eksperymenty: podgląd na żywo",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "tags": [
  "thesis"
 ],
 "templating": {
  "list": [
   {
    "name": "iface",
    "type": "custom",
    "label": "Interfejs",
    "query": "rest,graphql,grpc",
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "options": [],
    "datasource": null
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "RPS wg kodu odpowiedzi",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (code) (rate(api_requests_total{iface=~\"$iface\"}[5s]))",
     "legendFormat": "{{code}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latencja (po stronie serwera)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate(api_request_duration_seconds_bucket{iface=~\"$iface\"}[10s])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{iface=~\"$iface\"}[10s])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_seconds_bucket{iface=~\"$iface\"}[10s])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "CPU procesu aplikacji (rdzenie)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rate(process_cpu_seconds_total{job=\"app\",iface=~\"$iface\"}[5s])",
     "legendFormat": "{{iface}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "RAM procesu aplikacji (RSS)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "process_resident_memory_bytes{job=\"app\",iface=~\"$iface\"}",
     "legendFormat": "{{iface}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Goroutines i sterta Go",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "go_goroutines{job=\"app\",iface=~\"$iface\"}",
     "legendFormat": "goroutines {{iface}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "go_memstats_heap_inuse_bytes{job=\"app\",iface=~\"$iface\"}",
     "legendFormat": "sterta (B) {{iface}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Restarty i dostępność (up=0 → proces padł lub OOM)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "changes(process_start_time_seconds{job=\"app\",iface=~\"$iface\"}[5m])",
     "legendFormat": "restarty {{iface}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "up{job=\"app\",iface=~\"$iface\"}",
     "legendFormat": "up {{iface}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Odrzucenia: udział 4xx/5xx/429 i błędów gRPC",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (code) (rate(api_requests_total{iface=~\"$iface\",code!~\"200|201|OK\"}[5s]))",
     "legendFormat": "{{code}}"
    }
   ]
  }
 ]
}