# Punkty nasycenia C0 (RPS) z kalibracji A1: results/local_db3cpu/seria_a_A1_kalibracja.md
# (min z 3 powtórzeń, zaokrąglone w dół; PG_CPUS=3, commit d22c888, 2026-10-21).
# Format: SAT_<IFACE>_<OP>=<rps>  (IFACE wielkimi literami). Domyślnie 200 (brak kalibracji).
# UWAGA: dotyczą środowiska local_db3cpu (k6 + aplikacja + baza na jednym hoście, Postgres 3 CPU).
# Dla REST/gRPC O1 mierzą raczej limit generatora/hosta niż samej aplikacji.
SAT_REST_O1=7000
SAT_REST_O3=2230
SAT_GRAPHQL_O1=3550
SAT_GRAPHQL_O3=1070
SAT_GRPC_O1=4350
SAT_GRPC_O3=1530

# Seria D, GraphQL: siła napastnika [zapytania/s]. Wybrane 50 po kalibracji d_rate_cal (noc 19/20.11, docs/raport_noc.md p. 6):
# najniższa badana wartość, przy której aliasy 50 i limit 50 w C0 wyraźnie szkodzą legalnym (p95 1,35 -> 487,63 ms
# i 1,24 -> 1590,43 ms), a generator realizuje jeszcze 82-96% zaplanowanych żądań. Wartości 10-50 nie badano.
ATTACK_RATE_D_GRAPHQL=50
