# Punkty nasycenia C0 (RPS) z kalibracji A1: results/local_db3cpu/seria_a_A1_kalibracja.md
# (min z 3 powtórzeń, zaokrąglone w dół; PG_CPUS=3, commit d22c888, 2026-10-21).
# Format: SAT_<IFACE>_<OP>=<rps>  (IFACE wielkimi literami). Domyślnie 200 (brak kalibracji).
# UWAGA: dotyczą środowiska local_db3cpu (k6 + aplikacja + baza na jednym hoście, Postgres 3 CPU).
# Dla REST/gRPC O1 mierzą raczej limit generatora/hosta niż samej aplikacji.
SAT_REST_O1=7000
SAT_REST_O3=2230
SAT_GRAPHQL_O1=3550
SAT_GRAPHQL_O3=1070
SAT_GRPC_O1=4350
SAT_GRPC_O3=1530

# Seria D, GraphQL: siła napastnika [zapytania/s]. 10 = wartość pierwotna; w pilotażu 19.11 przy 10/s ataki GraphQL
# nie zmieniały p95 legalnych nawet w C0 (P2). Do ustawienia po bloku d_rate_cal (run_blocks.sh): 10/50/100/200 w C0.
ATTACK_RATE_D_GRAPHQL=10
